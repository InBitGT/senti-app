{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "senti-app",
  "version": "0.1.0",
  "identifier": "gt.inbit.senti",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:8081",
    "beforeDevCommand": "npx expo start --web",
    "beforeBuildCommand": "npx expo export --platform web"
  },
  "app": {
    "windows": [
      {
        "title": "Senti",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["./assets/senti_brand.png"],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
